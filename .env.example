# ==============================================
# Video2Content (VideoScribe) Environment Config
# ==============================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change_this_secret_key_in_production_min_32_characters

# CORS Settings (comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=videoscribe
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/videoscribe

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Object Storage (S3 / MinIO)
STORAGE_TYPE=minio
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=video2content-media
S3_REGION=us-east-1

# Speech-to-Text (STT) Provider (mock, openai, faster_whisper)
STT_PROVIDER=mock
OPENAI_API_KEY=your_openai_api_key_here

# Local Scratch / Temp Directory for Audio Processing
TEMP_MEDIA_DIR=./tmp/media

# Processing Limits
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=7200
